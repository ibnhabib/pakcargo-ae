---
import { sanityClient } from 'sanity:client';
import Layout from '../layouts/Layout.astro';
import { MapPin, Clock, ShieldCheck, Truck, PhoneCall, CheckCircle2 } from 'lucide-react';
import { getSiteSettings, getServices } from '../lib/sanity';
import { ORIGIN_HUBS_QUERY, DESTINATION_HUBS_QUERY } from '../lib/queries';

// Route pages are the cross-product of every originHub x destinationHub document in Sanity.
// Add a city in Studio and every combination with the other side gets a page automatically.
export async function getStaticPaths() {
  const origins = await sanityClient.fetch(ORIGIN_HUBS_QUERY);
  const destinations = await sanityClient.fetch(DESTINATION_HUBS_QUERY);

  const routes = [];
  for (const origin of origins) {
    for (const destination of destinations) {
      routes.push({
        params: { route: `${origin.slug}-to-${destination.slug}-cargo` },
        props: { origin, destination },
      });
    }
  }
  return routes;
}

const { origin, destination } = Astro.props;
const settings = await getSiteSettings();
const services = ((await getServices()) || []).slice(0, 3);

const routeSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: `Cargo Shipping from ${origin.name} to ${destination.name}`,
  serviceType: 'FreightTransportService',
  provider: { '@id': 'https://pakcargo.ae/#organization' },
  areaServed: [
    { '@type': 'City', name: origin.name, containedInPlace: { '@type': 'Country', name: 'United Arab Emirates' } },
    { '@type': 'City', name: destination.name, containedInPlace: { '@type': 'Country', name: 'Pakistan' } },
  ],
  description: `Door-to-door cargo shipping from ${origin.name}, UAE to ${destination.name}, Pakistan. Pickup across ${(origin.pickupAreas || []).join(', ')}, delivery via ${destination.customsHub}.`,
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://pakcargo.ae' },
    {
      '@type': 'ListItem',
      position: 2,
      name: `${origin.name} to ${destination.name} Cargo`,
      item: `https://pakcargo.ae/${origin.slug}-to-${destination.slug}-cargo`,
    },
  ],
};
---

<Layout
  title={`${origin.name} to ${destination.name} Cargo | Door to Door Shipping`}
  description={`Send cargo from ${origin.name} to ${destination.name} with door-to-door pickup and delivery. Sea and air freight, customs cleared at ${destination.customsHub}. Get a quote today.`}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(routeSchema)} slot="head" />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} slot="head" />

  <main class="bg-slate-50">
    <section class="bg-slate-900 py-24 relative overflow-hidden">
      <div class="max-w-6xl mx-auto px-6 relative z-10">
        <div
          class="inline-flex items-center gap-2 px-3 py-1 bg-blue-500/20 border border-blue-500/30 rounded-full text-blue-300 text-xs font-bold mb-6"
        >
          <MapPin size={14} />
          <span>{origin.name}, UAE &rarr; {destination.name}, {destination.province}</span>
        </div>
        <h1 class="text-4xl md:text-7xl font-black text-white mb-6">
          {origin.name} to <span class="text-blue-500">{destination.name}</span> Cargo
        </h1>
        <p class="text-slate-400 text-lg max-w-2xl leading-relaxed">
          Door-to-door pickup across {origin.name} and reliable delivery to {destination.name} and
          surrounding areas, with customs cleared at {destination.customsHub}.
        </p>
      </div>
    </section>

    <section class="py-12 bg-white border-b border-slate-100">
      <div class="max-w-6xl mx-auto px-6 grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="p-6 bg-slate-50 rounded-3xl border border-slate-100">
          <div class="flex items-center gap-3 mb-4 text-blue-600">
            <Clock size={24} />
            <span class="font-black uppercase tracking-widest text-xs">Estimated Transit Time</span>
          </div>
          <p class="text-2xl font-bold text-slate-900">{destination.transitTimeline}</p>
          <p class="text-sm text-slate-500 mt-2">Includes customs processing at {destination.customsHub}.</p>
        </div>
        <div class="p-6 bg-slate-50 rounded-3xl border border-slate-100">
          <div class="flex items-center gap-3 mb-4 text-green-600">
            <ShieldCheck size={24} />
            <span class="font-black uppercase tracking-widest text-xs">Service Status</span>
          </div>
          <p class="text-2xl font-bold text-slate-900">Active &amp; Secure</p>
          <p class="text-sm text-slate-500 mt-2">Regular departures from {origin.name} to {destination.name}.</p>
        </div>
      </div>
    </section>

    <section class="py-16 bg-white border-b border-slate-100">
      <div class="max-w-6xl mx-auto px-6">
        <h2 class="text-sm font-bold text-slate-400 uppercase tracking-widest mb-6 text-center">
          Pickup Locations in {origin.name}
        </h2>
        <div class="flex flex-wrap justify-center gap-3">
          {
            (origin.pickupAreas || []).map((area) => (
              <span class="px-5 py-2 bg-slate-50 border border-slate-200 rounded-full text-slate-700 font-medium text-sm">
                {area}
              </span>
            ))
          }
        </div>
      </div>
    </section>

    <section class="py-16 max-w-6xl mx-auto px-6">
      <h2 class="text-3xl md:text-4xl font-black text-slate-900 mb-4 italic text-center">
        Delivery Coverage Near {destination.name}
      </h2>
      <p class="text-slate-600 mb-10 text-center max-w-2xl mx-auto">
        From our {destination.name} hub, we deliver directly to the following districts.
      </p>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
        {
          (destination.coverageAreas || []).map((area) => (
            <div class="flex items-center gap-3 p-4 bg-white rounded-2xl border border-slate-100 shadow-sm">
              <CheckCircle2 size={18} className="text-blue-500 shrink-0" />
              <span class="font-bold text-slate-800 text-sm">{area}</span>
            </div>
          ))
        }
      </div>
    </section>

    <section class="py-16 bg-white border-y border-slate-100">
      <div class="max-w-6xl mx-auto px-6">
        <h2 class="text-3xl md:text-4xl font-black text-slate-900 mb-10 italic text-center">
          Available Services
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {
            services.map((service) => (
              <div class="group bg-slate-50 rounded-[2rem] border border-slate-200 p-8 hover:shadow-xl hover:border-blue-500 transition-all">
                <div class="mb-6 p-4 bg-white rounded-2xl w-fit group-hover:bg-blue-600 group-hover:text-white transition-colors">
                  <Truck size={24} />
                </div>
                <h3 class="text-xl font-bold text-slate-900 mb-3">{service.title}</h3>
                <p class="text-slate-600 text-sm mb-6 line-clamp-3">{service.description}</p>
                <a
                  href={`/services/${service.slug.current}`}
                  class="flex items-center gap-2 font-bold text-blue-600 hover:gap-4 transition-all text-sm"
                >
                  View Rates <span>&rarr;</span>
                </a>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="max-w-6xl mx-auto px-6 py-24 text-center">
      <div class="bg-blue-600 rounded-[3rem] p-12 text-white shadow-2xl shadow-blue-200">
        <h2 class="text-3xl md:text-5xl font-black mb-6">
          Ship from {origin.name} to {destination.name} Today
        </h2>
        <p class="text-blue-100 mb-10 text-lg">Contact our team for weight-based rates on this route.</p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href={`tel:${settings?.phone}`}
            class="bg-white text-blue-600 px-8 py-4 rounded-2xl font-black flex items-center justify-center gap-2"
          >
            <PhoneCall size={18} /> Call Specialist
          </a>
          <a
            href={`https://wa.me/${settings?.whatsappNumber}?text=Hi, I want to ship from ${origin.name} to ${destination.name}.`}
            class="bg-green-500 text-white px-8 py-4 rounded-2xl font-black flex items-center justify-center gap-2"
          >
            WhatsApp Quote
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>
