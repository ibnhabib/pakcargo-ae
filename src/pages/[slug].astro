---
import { sanityClient } from 'sanity:client';
import Layout from '../layouts/Layout.astro';
import PortableText from '../components/PortableText.astro';
import { PAGE_SLUGS_QUERY } from '../lib/queries';

export async function getStaticPaths() {
  const data = await sanityClient.fetch(PAGE_SLUGS_QUERY);

  return data.map((item) => ({
    params: { slug: item.slug?.current },
    props: { item },
  }));
}

const { item } = Astro.props;

if (!item) {
  return Astro.redirect('/404');
}
---

<Layout
  title={item.seoTitle || item.title}
  description={item.metaDescription}
>
  <main class="relative pt-32 pb-20 bg-slate-50 min-h-screen">
    <div class="max-w-5xl mx-auto px-6">
      <header class="mb-12">
        <div
          class="flex items-center gap-3 text-blue-600 font-bold mb-4 uppercase tracking-widest text-sm"
        >
          <span class="px-3 py-1 bg-blue-100 rounded-lg">Information</span>
        </div>
        <h1 class="text-4xl md:text-7xl font-black text-slate-900 mb-6 tracking-tight leading-none">
          {item.title}
        </h1>
      </header>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        <div class="lg:col-span-2 space-y-12">
          <article
            class="bg-white p-8 md:p-12 rounded-[2.5rem] shadow-sm border border-slate-100 prose prose-slate prose-lg max-w-none"
          >
            <PortableText value={item.content} />
          </article>
        </div>

        <div class="space-y-8">
          <div class="bg-slate-900 p-8 rounded-[2rem] text-center text-white">
            <h3 class="text-2xl font-black mb-4">Need a Quote?</h3>
            <p class="text-slate-400 mb-6">Fast & secure shipping to Pakistan.</p>
            <a
              href="/contact"
              class="block w-full py-4 bg-blue-600 hover:bg-blue-700 rounded-2xl font-black transition-all"
            >
              Contact Us Now
            </a>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>
