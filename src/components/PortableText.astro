---
import { PortableText as PortableTextInternal } from 'astro-portabletext';
import SanityImage from './portable-text/SanityImage.astro';
import CustomsAlert from './portable-text/CustomsAlert.astro';
import Heading2 from './portable-text/Heading2.astro';
import Heading3 from './portable-text/Heading3.astro';
import Blockquote from './portable-text/Blockquote.astro';
import Paragraph from './portable-text/Paragraph.astro';
import BulletList from './portable-text/BulletList.astro';
import NumberList from './portable-text/NumberList.astro';

const { value } = Astro.props;

const components = {
  type: {
    image: SanityImage,
  },
  block: {
    // H4 is your "Customs Alert" - Perfect for Logistics Monopoly
    h4: CustomsAlert,
    h2: Heading2,
    h3: Heading3,
    blockquote: Blockquote,
    normal: Paragraph,
  },
  list: {
    bullet: BulletList,
    number: NumberList,
  },
};
---

<div
  class="prose prose-lg prose-slate max-w-none
  prose-headings:font-black prose-headings:text-slate-900
  prose-p:text-slate-600 prose-p:leading-relaxed
  prose-strong:text-blue-700 prose-strong:font-bold
  prose-a:text-blue-600 prose-a:font-bold prose-a:no-underline hover:prose-a:underline
  prose-li:marker:text-blue-500"
>
  <PortableTextInternal value={value} components={components} />
</div>
